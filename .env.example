# Core services
POSTGRES_DB=civicgrid
POSTGRES_USER=civicgrid
POSTGRES_PASSWORD=civicgrid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=dev-qdrant-key

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=local
API_LOG_LEVEL=info

# Worker simulation
SIM_WORKER_COUNT=8
SIM_MAX_RUNTIME_SECONDS=20
SIM_REPLICA_FACTOR=3
SIM_GOLD_TASK_RATIO=0.15
